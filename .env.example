# ==============================================================================
# Discord Bot Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Duplicate this file and rename it to `.env`
# 2. Replace the placeholder values with your actual Discord Bot credentials
# ==============================================================================

# Your Discord Bot Token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# (Optional) Guild ID for instant slash command sync during development.
# If provided, commands sync immediately in this server rather than taking up to 1 hour globally.
# Leave empty for global registration.
GUILD_ID=
